{
  "name": "@droidsolutions-oss/semantic-release-update-file",
  "version": "2.0.0",
  "description": "Semantic Release plugin to help with updating files during release.",
  "type": "module",
  "main": "dist/index.mjs",
  "files": [
    "CHANGELOG.md",
    "dist/index.mjs",
    "dist/lib/**/*.mjs"
  ],
  "engines": {
    "node": "^22.14.0 || >= 24.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "coverage": "c8 mocha test/**/*.test.mts",
    "build": "tsc",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "mocha test/**/*.test.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/droidsolutions/semantic-release-update-file.git"
  },
  "keywords": [
    "semantic",
    "semantic-release",
    "release",
    "file",
    "version",
    "semantic-version",
    "plugin",
    "semantic-release-plugin"
  ],
  "author": "Stefan Ißmer <stefan.issmer@droidsolutions.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/droidsolutions/semantic-release-update-file/issues"
  },
  "homepage": "https://github.com/droidsolutions/semantic-release-update-file#readme",
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "12.0.9",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.0",
    "@types/sinon": "^22.0.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-mocha": "^12.0.0",
    "eslint-plugin-n": "^18.0.1",
    "globals": "^17.0.0",
    "husky": "^9.0.1",
    "lint-staged": "^17.0.2",
    "mocha": "^11.0.1",
    "prettier": "^3.0.0",
    "semantic-release": "25.0.9",
    "sinon": "^22.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.13.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts}": [
      "prettier --write",
      "eslint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "c8": {
    "all": true,
    "extension": [
      ".mts"
    ],
    "include": [
      "lib/**/*.mts"
    ],
    "exclude": [
      "lib/UserConfig.mts"
    ],
    "reporter": [
      "html",
      "text"
    ]
  }
}
